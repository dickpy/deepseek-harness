{
  "name": "@deepseek-ai/dsh-plugin-enterprise",
  "version": "0.1.7-alpha.2",
  "description": "企业版内置插件：设备注册、云端模型下发应用、用量遥测上报（dsh-enterprise 管理平台配套）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
